---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CmsContent from "../components/CmsContent.astro";
import PageHero from "../components/PageHero.astro";
import { contentWidthClass } from "../cms/fields/content-width";
import { resolveEntrySiteCode } from "../cms/fields/entry-site-code";
import { hasContentEmbeds } from "../lib/content-embeds";
import {
	contentSpacingStyle,
	resolveContentSpacing,
} from "../lib/content-spacing";
import { resolveContentWidth } from "../lib/content-width";
import { resolveCmsImage } from "../lib/cms-image";
import { isPagePublic } from "../lib/pages";
import { resolveTocForCollection } from "../lib/site-config";

const page = await getEntry("pages", "index");
if (!page) {
	throw new Error('Missing pages collection entry "index".');
}
if (!isPagePublic(page)) {
	throw new Error('Start page "index" is not public (check status / publishDate).');
}
const useEmbeds = hasContentEmbeds(page.body);
const { Content } = await render(page);
const backgroundImage = resolveCmsImage(
	page.data.background?.image,
	`content/pages/${page.id}/`,
);
const contentWidth = await resolveContentWidth("pages", page.data, page.body);
const widthClass = contentWidthClass(contentWidth);
const spacingStyle = contentSpacingStyle(
	resolveContentSpacing("pages", page.data),
);
const toc = await resolveTocForCollection("pages", page.data);
/** Home has no trail; PageHero hides breadcrumbs when length ≤ 1. */
const heroProps = {
	title: page.data.title,
	description: page.data.description,
	collection: "pages" as const,
	hero: page.data.hero,
};
/** Dynamic import: avoid shipping TOC CSS on pages that do not show a TOC. */
const TableOfContents = toc.show
	? (await import("../components/TableOfContents.astro")).default
	: null;
const { headCode, footerCode } = resolveEntrySiteCode(page.data);
---

<BaseLayout
	title={page.data.title}
	description={page.data.description}
	seo={page.data.seo}
	modifiedDate={page.data.modifiedDate}
	backgroundImage={backgroundImage}
	backgroundOverlay={page.data.background?.overlay}
	headCode={headCode}
	footerCode={footerCode}
>
	<main class:list={["page", widthClass]} style={spacingStyle}>
		<article>
			<PageHero {...heroProps} />
			{TableOfContents && (
				<TableOfContents
					body={page.body}
					levels={toc.levels}
					title={toc.title}
				/>
			)}
			{useEmbeds ? <CmsContent body={page.body} /> : <Content />}
		</article>
	</main>
</BaseLayout>
