---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import ArticleNav from "../../components/ArticleNav.astro";
import AuthorByline from "../../components/AuthorByline.astro";
import CmsContent from "../../components/CmsContent.astro";
import Icon from "../../components/Icon.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import {
	formatArticleDate,
	getAdjacentArticles,
	getArticleHref,
	getPublishedArticles,
} from "../../lib/articles";
import { getAuthorsByIds } from "../../lib/authors";
import { resolveCmsImage } from "../../lib/cms-image";
import { contentWidthClass } from "../../cms/fields/content-width";
import { resolveEntrySiteCode } from "../../cms/fields/entry-site-code";
import { hasContentEmbeds } from "../../lib/content-embeds";
import {
	contentSpacingStyle,
	resolveContentSpacing,
} from "../../lib/content-spacing";
import { resolveContentWidth } from "../../lib/content-width";
import {
	estimateReadingTimeMinutes,
	formatReadingTime,
} from "../../lib/reading-time";
import { buildArticleBreadcrumbs } from "../../lib/breadcrumbs";
import { getCategoryHref } from "../../lib/categories";
import {
	getAuthorsDisplayConfig,
	resolveTocForCollection,
} from "../../lib/site-config";
import { formatTagHashtag, getTagHref } from "../../lib/tags";

export async function getStaticPaths() {
	const articles = await getPublishedArticles();
	return articles.map((article) => ({
		params: { slug: article.id },
		props: { article },
	}));
}

const { article } = Astro.props;
const useEmbeds = hasContentEmbeds(article.body);
const { Content } = await render(article);
const contentWidth = await resolveContentWidth(
	"articles",
	article.data,
	article.body,
);
const widthClass = contentWidthClass(contentWidth);
const spacingStyle = contentSpacingStyle(
	resolveContentSpacing("articles", article.data),
);
const { older, newer } = await getAdjacentArticles(article);
const [tags, categories] = await Promise.all([
	getCollection("tags"),
	getCollection("categories"),
]);
const tagMap = new Map(tags.map((tag) => [tag.id, tag]));
const categoryMap = new Map(categories.map((cat) => [cat.id, cat]));
const linkedTags = (article.data.tags ?? [])
	.map((id) => tagMap.get(id))
	.filter((tag): tag is (typeof tags)[number] => Boolean(tag));
const linkedCategories = (article.data.categories ?? [])
	.map((id) => categoryMap.get(id))
	.filter((cat): cat is (typeof categories)[number] => Boolean(cat))
	.sort((a, b) =>
		a.data.title.localeCompare(b.data.title, "de", { sensitivity: "base" }),
	);
const tagPlacement = article.data.tagPlacement ?? "hero";
const showTagsInHero =
	linkedTags.length > 0 &&
	(tagPlacement === "hero" || tagPlacement === "both");
const showTagsAfter =
	linkedTags.length > 0 &&
	(tagPlacement === "after" || tagPlacement === "both");
const linkedAuthors = await getAuthorsByIds(article.data.authors ?? []);
const authorsDisplay = getAuthorsDisplayConfig();
const showAuthorsInHero =
	linkedAuthors.length > 0 &&
	(authorsDisplay.articlePlacement === "hero" ||
		authorsDisplay.articlePlacement === "both");
const showAuthorsAfter =
	linkedAuthors.length > 0 &&
	(authorsDisplay.articlePlacement === "after" ||
		authorsDisplay.articlePlacement === "both");
const showHeroTaxonomies =
	linkedCategories.length > 0 || showTagsInHero || showAuthorsInHero;
const articleEntryDir = `content/articles/${article.id}/`;
const backgroundImage = resolveCmsImage(
	article.data.background?.image,
	articleEntryDir,
);
const heroImage = resolveCmsImage(article.data.heroImage, articleEntryDir);
const toc = await resolveTocForCollection("articles", article.data);
/** Dynamic import: avoid shipping TOC CSS on pages that do not show a TOC. */
const TableOfContents = toc.show
	? (await import("../../components/TableOfContents.astro")).default
	: null;
const readingTimeMinutes = estimateReadingTimeMinutes(article.body);
const readingTimeLabel = formatReadingTime(readingTimeMinutes);
const breadcrumbs = buildArticleBreadcrumbs(article);
const { headCode, footerCode } = resolveEntrySiteCode(article.data);
---

<BaseLayout
	title={article.data.title}
	description={article.data.summary}
	seo={article.data.seo}
	ogType="article"
	readingTimeMinutes={readingTimeMinutes}
	modifiedDate={article.data.modifiedDate}
	backgroundImage={backgroundImage}
	backgroundOverlay={article.data.background?.overlay}
	headCode={headCode}
	footerCode={footerCode}
>
	<main class:list={["page", widthClass]} style={spacingStyle}>
		<article>
			<p class="text-sm text-muted">
				<time datetime={article.data.pubDate.toISOString()}>
					{formatArticleDate(article.data.pubDate)}
				</time>
				{" · "}
				<span>{readingTimeLabel}</span>
			</p>
			<PageHero
				title={article.data.title}
				description={article.data.summary}
				breadcrumbs={breadcrumbs}
				collection="articles"
				hero={article.data.hero}
			>
				{
					(showHeroTaxonomies || showAuthorsInHero) && (
						<div class="page-hero__below" slot="below">
							{showHeroTaxonomies && (
								<div class="page-hero__taxonomies flex-row flex-between flex-wrap gap-md text-sm">
									{linkedCategories.length > 0 ? (
										<ul
											class="article-categories list-plain flex-row flex-wrap gap-md"
											aria-label="Kategorien"
										>
											{linkedCategories.map((cat) => (
												<li>
													<a
														class="article-categories__link"
														href={getCategoryHref(cat)}
													>
														<Icon
															name="category"
															class="article-categories__icon"
														/>
														{cat.data.title}
													</a>
												</li>
											))}
										</ul>
									) : (
										<span />
									)}
									{showTagsInHero && (
										<ul
											class="article-tags list-plain flex-row flex-wrap gap-md"
											aria-label="Tags"
										>
											{linkedTags.map((tag) => (
												<li>
													<a href={getTagHref(tag)}>
														{formatTagHashtag(tag)}
													</a>
												</li>
											))}
										</ul>
									)}
								</div>
							)}
							{showAuthorsInHero && (
								<div class="article-authors article-authors--hero">
									<AuthorByline
										authors={linkedAuthors}
										avatarShape={authorsDisplay.avatarShape}
									/>
								</div>
							)}
						</div>
					)
				}
			</PageHero>
			{TableOfContents && (
				<TableOfContents
					body={article.body}
					levels={toc.levels}
					title={toc.title}
				/>
			)}
			{
				heroImage &&
					article.data.showHeroImage && (
						<figure class="article-hero-image">
							<Image
								src={heroImage}
								alt={article.data.title}
								widths={[640, 960]}
								sizes="(max-width: 679px) 100vw, 42rem"
							/>
						</figure>
					)
			}
			{useEmbeds ? <CmsContent body={article.body} /> : <Content />}
			{
				showTagsAfter && (
					<ul
						class="article-tags article-tags--after list-plain flex-row flex-wrap gap-md text-sm"
						aria-label="Tags"
					>
						{linkedTags.map((tag) => (
							<li>
								<a href={getTagHref(tag)}>{formatTagHashtag(tag)}</a>
							</li>
						))}
					</ul>
				)
			}
			{
				showAuthorsAfter && (
					<div class="article-authors article-authors--after">
						<AuthorByline
							authors={linkedAuthors}
							avatarShape={authorsDisplay.avatarShape}
						/>
					</div>
				)
			}
			<ArticleNav older={older} newer={newer} />
		</article>
		<p class="text-sm entry-footer-links">
			<a href="/artikel/">← Alle Artikel</a>
			{" · "}
			<a
				class="permalink-link"
				href={getArticleHref(article)}
				aria-current="page"
			>
				<Icon name="permalink" class="permalink-link__icon" />
				Permalink
			</a>
		</p>
	</main>
</BaseLayout>

<style>
	.article-hero-image {
		margin: 0 0 3rem;
		padding: 0;
	}

	.article-hero-image :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 6px;
	}

	.article-tags--after {
		margin: 1.5rem 0 0;
		padding: 0;
	}

	.article-authors--hero {
		margin-top: 0.85rem;
	}

	.article-authors--after {
		margin: 1.5rem 0 0;
	}
</style>
