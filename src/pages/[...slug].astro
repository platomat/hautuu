---
import { render } from "astro:content";
import BackgroundAttributions from "../components/BackgroundAttributions.astro";
import CmsContent from "../components/CmsContent.astro";
import PageHero from "../components/PageHero.astro";
import ArticleSidebar from "../components/ArticleSidebar.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { contentWidthClass } from "../cms/fields/content-width";
import { resolveEntrySiteCode } from "../cms/fields/entry-site-code";
import { hasContentEmbeds } from "../lib/content-embeds";
import {
	contentSpacingStyle,
	resolveContentSpacing,
} from "../lib/content-spacing";
import { resolveContentWidth } from "../lib/content-width";
import { resolveCmsImage } from "../lib/cms-image";
import { buildPageBreadcrumbs } from "../lib/breadcrumbs";
import { getPageHref, getPublicPages, indexPagesById } from "../lib/pages";
import { resolveTocForCollection } from "../lib/site-config";

export async function getStaticPaths() {
	const pages = await getPublicPages();
	const pagesById = indexPagesById(pages);

	return pages
		.filter((page) => getPageHref(page, pagesById) !== "/")
		.map((page) => {
			const href = getPageHref(page, pagesById);
			const slug = href.replace(/^\/|\/$/g, "");
			return {
				params: { slug },
				props: { page },
			};
		});
}

const { page } = Astro.props;
const useEmbeds = hasContentEmbeds(page.body);
const { Content } = await render(page);
const backgroundImage = resolveCmsImage(
	page.data.background?.image,
	`content/pages/${page.id}/`,
);
/** Hardwired system pages (same idea as Impressum attributions). */
const showBackgroundAttributions = page.id === "impressum";
/** Artikel overview: category tree + tags sidebar; listing from CMS embed. */
const showArticleSidebar = page.id === "artikel";
const contentWidth = await resolveContentWidth("pages", page.data, page.body);
const widthClass = contentWidthClass(contentWidth);
const spacingStyle = contentSpacingStyle(
	resolveContentSpacing("pages", page.data),
);
const toc = await resolveTocForCollection("pages", page.data);
const allPages = await getPublicPages();
const breadcrumbs = buildPageBreadcrumbs(page, allPages);
const heroProps = {
	title: page.data.title,
	description: page.data.description,
	breadcrumbs,
	collection: "pages" as const,
	hero: page.data.hero,
};
/** Dynamic import: avoid shipping TOC CSS on pages that do not show a TOC. */
const TableOfContents = toc.show
	? (await import("../components/TableOfContents.astro")).default
	: null;
const { headCode, footerCode } = resolveEntrySiteCode(page.data);
---

<BaseLayout
	title={page.data.title}
	description={page.data.description}
	seo={page.data.seo}
	modifiedDate={page.data.modifiedDate}
	backgroundImage={backgroundImage}
	backgroundOverlay={page.data.background?.overlay}
	headCode={headCode}
	footerCode={footerCode}
>
	<main
		class:list={[
			"page",
			widthClass,
			{ "page--with-sidebar": showArticleSidebar },
		]}
		style={spacingStyle}
	>
		{
			showArticleSidebar ? (
				<div class="page-layout flex-row gap-lg stack-on-tablet">
					<div class="page-layout__main min-w-0 w-full">
						<article>
							<PageHero {...heroProps} />
							{TableOfContents && (
								<TableOfContents
									body={page.body}
									levels={toc.levels}
									title={toc.title}
								/>
							)}
							{useEmbeds ? <CmsContent body={page.body} /> : <Content />}
						</article>
					</div>
					<ArticleSidebar />
				</div>
			) : (
				<article>
					<PageHero {...heroProps} />
					{TableOfContents && (
						<TableOfContents
							body={page.body}
							levels={toc.levels}
							title={toc.title}
						/>
					)}
					{useEmbeds ? <CmsContent body={page.body} /> : <Content />}
					{showBackgroundAttributions && <BackgroundAttributions />}
				</article>
			)
		}
	</main>
</BaseLayout>
