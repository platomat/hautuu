---
import { getImage, Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import ArticleListing from "../../components/ArticleListing.astro";
import AuthorSocialLinks from "../../components/AuthorSocialLinks.astro";
import CmsContent from "../../components/CmsContent.astro";
import { getArticlesByAuthor } from "../../lib/articles";
import {
	getAuthorHref,
	resolveAuthorAvatar,
	type AuthorEntry,
} from "../../lib/authors";
import { buildAuthorBreadcrumbs } from "../../lib/breadcrumbs";
import { contentWidthClass } from "../../cms/fields/content-width";
import { resolveEntrySiteCode } from "../../cms/fields/entry-site-code";
import { resolveCmsImage } from "../../lib/cms-image";
import {
	contentSpacingStyle,
	resolveContentSpacing,
} from "../../lib/content-spacing";
import { resolveContentWidth } from "../../lib/content-width";

export async function getStaticPaths() {
	const authors = await getCollection("authors");
	return authors.map((author) => ({
		params: { slug: author.id },
		props: { author },
	}));
}

const { author } = Astro.props as { author: AuthorEntry };
const articles = await getArticlesByAuthor(author.id, { sort: "newest" });
const avatar = resolveAuthorAvatar(author);
const breadcrumbs = buildAuthorBreadcrumbs(author);
const spacingStyle = contentSpacingStyle(resolveContentSpacing("authors"));
const bio = author.data.bio?.trim() || "";
const socialLinks = author.data.socialLinks ?? [];
const showSocialInHero = author.data.showSocialInHero === true;
const hasBody = Boolean(author.body?.trim());
const widthClass = contentWidthClass(
	await resolveContentWidth("authors", undefined, author.body),
);
const backgroundImage = resolveCmsImage(author.data.background?.image);
const showAutoSocialInHero =
	showSocialInHero &&
	socialLinks.some((link) => link.url?.trim());
const articleCount = articles.length;
const articlesHeading =
	articleCount === 1 ? "Artikel (1)" : `Artikel (${articleCount})`;

const sameAs = socialLinks
	.map((link) => link.url.trim())
	.filter(Boolean);
const profileUrl = Astro.site
	? new URL(getAuthorHref(author), Astro.site).href
	: undefined;
let imageUrl: string | undefined;
if (avatar && Astro.site) {
	const optimized = await getImage({
		src: avatar,
		width: 400,
		height: 400,
		fit: "cover",
		format: "jpg",
	});
	imageUrl = new URL(optimized.src, Astro.site).href;
}
const personJsonLd: Record<string, unknown> = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: author.data.title,
};
if (author.data.description?.trim()) {
	personJsonLd.description = author.data.description.trim();
}
if (profileUrl) personJsonLd.url = profileUrl;
if (imageUrl) personJsonLd.image = imageUrl;
if (sameAs.length > 0) personJsonLd.sameAs = sameAs;
const { headCode, footerCode } = resolveEntrySiteCode(author.data);
---

<BaseLayout
	title={author.data.title}
	description={author.data.description}
	seo={author.data.seo}
	modifiedDate={author.data.modifiedDate}
	backgroundImage={backgroundImage}
	backgroundOverlay={author.data.background?.overlay}
	jsonLd={personJsonLd}
	headCode={headCode}
	footerCode={footerCode}
>
	<main class:list={["page", widthClass]} style={spacingStyle}>
		<PageHero
			title={author.data.title}
			description={author.data.description}
			breadcrumbs={breadcrumbs}
			collection="authors"
		>
			{
				avatar && (
					<div class="author-profile__avatar-wrap" slot="beforeTitle">
						<Image
							class="author-profile__avatar"
							src={avatar}
							alt=""
							width={160}
							height={160}
						/>
					</div>
				)
			}
			{
				showAutoSocialInHero && (
					<AuthorSocialLinks
						slot="below"
						links={socialLinks}
						inHero
					/>
				)
			}
		</PageHero>
		{
			bio && (
				<div class="author-profile__bio">
					<CmsContent body={bio} defaultAuthorId={author.id} />
				</div>
			)
		}
		{
			hasBody ? (
				<div class="author-profile__content">
					<CmsContent body={author.body} defaultAuthorId={author.id} />
				</div>
			) : (
				<section
					class="author-profile__articles"
					aria-labelledby="author-articles"
				>
					<h2 id="author-articles">{articlesHeading}</h2>
					{articleCount === 0 ? (
						<p>Keine veröffentlichten Artikel von diesem Autor.</p>
					) : (
						<ArticleListing
							authorId={author.id}
							count={0}
							sort="newest"
							layout="grid"
							columns={1}
							gap={3}
						/>
					)}
				</section>
			)
		}
	</main>
</BaseLayout>

<style>
	.author-profile__avatar-wrap {
		margin: 2rem 0;
	}

	.author-profile__avatar {
		/* inline-block: follows PageHero text-align (left / center / right) */
		display: inline-block;
		width: 8rem;
		height: 8rem;
		object-fit: cover;
		border-radius: 50%;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		vertical-align: middle;
	}

	.author-profile__bio {
		margin: 0 0 2rem;
	}

	.author-profile__content {
		margin: 0 0 2rem;
	}

	.author-profile__articles h2 {
		margin-top: 0;
	}
</style>
