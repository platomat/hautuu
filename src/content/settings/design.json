{
  "colors": {
    "bg": "#0f1412",
    "surface": "#1a211e",
    "surfaceGlass": "#1a211e88",
    "surfaceRaised": "#232b27",
    "border": "#2e3833",
    "text": "#e8eeea",
    "textMuted": "#9aa89f",
    "action": "#3dcf8e",
    "actionHover": "#56d9a0",
    "actionMuted": "#1a3d2e",
    "danger": "#e57373",
    "submenuBg": "#1a211e",
    "submenuText": "#e8eeea"
  },
  "typography": {
    "bodyFont": "ubuntu",
    "baseSize": 16,
    "bodyWeight": 300,
    "headingFont": "ubuntu",
    "headings": {
      "h1": {
        "size": 2,
        "weight": 500,
        "transform": "none"
      },
      "h2": {
        "size": 1.5,
        "weight": 500,
        "transform": "none"
      },
      "h3": {
        "size": 1.25,
        "weight": 500,
        "transform": "none"
      },
      "h4": {
        "size": 1.125,
        "weight": 500,
        "transform": "none"
      },
      "h5": {
        "size": 1,
        "weight": 500,
        "transform": "none"
      },
      "h6": {
        "size": 0.875,
        "weight": 500,
        "transform": "none"
      }
    }
  },
  "header": {
    "logoPosition": "left",
    "contentWidth": "wide",
    "menu": "main",
    "search": "visible",
    "minHeightDesktop": 64,
    "minHeightTablet": 64,
    "minHeightMobile": 56,
    "stickyDesktop": true,
    "stickyTablet": true,
    "stickyMobile": true,
    "heightDesktop": 48,
    "heightTablet": 48,
    "heightMobile": 40
  },
  "hero": {
    "pages": {
      "textAlign": "left",
      "showBreadcrumbs": true,
      "breadcrumbSeparator": "/",
      "borderBottom": "logo",
      "borderMarkAlign": "center",
      "borderMarkSize": 24
    },
    "articles": {
      "textAlign": "left",
      "showBreadcrumbs": true,
      "breadcrumbSeparator": "/",
      "borderBottom": false,
      "borderMarkAlign": "center",
      "borderMarkSize": 24
    },
    "categories": {
      "textAlign": "left",
      "showBreadcrumbs": true,
      "breadcrumbSeparator": "/",
      "borderBottom": false,
      "borderMarkAlign": "center",
      "borderMarkSize": 24
    },
    "tags": {
      "textAlign": "left",
      "showBreadcrumbs": true,
      "breadcrumbSeparator": "/",
      "borderBottom": false,
      "borderMarkAlign": "center",
      "borderMarkSize": 24
    },
    "authors": {
      "textAlign": "center",
      "showBreadcrumbs": true,
      "breadcrumbSeparator": "/",
      "borderBottom": "logo",
      "borderMarkAlign": "center",
      "borderMarkSize": 24
    },
    "glossar": {
      "textAlign": "left",
      "showBreadcrumbs": true,
      "breadcrumbSeparator": "/",
      "borderBottom": false,
      "borderMarkAlign": "center",
      "borderMarkSize": 24
    }
  },
  "contentWidth": {
    "pages": "default",
    "articles": "default",
    "categories": "default",
    "tags": "default",
    "authors": "default",
    "glossar": "default"
  },
  "spacing": {
    "pages": {
      "afterHero": 6,
      "beforeFooter": 6
    },
    "articles": {
      "afterHero": 6,
      "beforeFooter": 6
    },
    "categories": {
      "afterHero": 6,
      "beforeFooter": 6
    },
    "tags": {
      "afterHero": 6,
      "beforeFooter": 6
    },
    "authors": {
      "afterHero": 6,
      "beforeFooter": 6
    },
    "glossar": {
      "afterHero": 6,
      "beforeFooter": 6
    }
  },
  "borderRadius": {
    "image": 6,
    "video": 6
  }
}
