---
import ArticleListing from "./ArticleListing.astro";
import AuthorListing from "./AuthorListing.astro";
import AuthorSocialLinks from "./AuthorSocialLinks.astro";
import CategoryListing from "./CategoryListing.astro";
import CmsButton from "./CmsButton.astro";
import CmsButtonGroup from "./CmsButtonGroup.astro";
import CmsGridCards from "./CmsGridCards.astro";
import CmsLogo from "./CmsLogo.astro";
import CmsContactEmailFlow from "./CmsContactEmailFlow.astro";
import ContactEmail from "./ContactEmail.astro";
import GlossarListing from "./GlossarListing.astro";
import Separator from "./Separator.astro";
import Spacer from "./Spacer.astro";
import TagCloud from "./TagCloud.astro";
import TagListing from "./TagListing.astro";
import RepoDocLink from "./RepoDocLink.astro";
import MemberVideo from "./MemberVideo.astro";
import VideoConsentReset from "./VideoConsentReset.astro";
import VideoEmbed from "./VideoEmbed.astro";
import { buildContentSegments } from "../lib/content-embeds";

interface Props {
	body: string | undefined;
	/** Current author profile slug for `{{author-social}}` without `author=`. */
	defaultAuthorId?: string;
}

const { body, defaultAuthorId } = Astro.props;
const segments = await buildContentSegments(body);
---

{
	segments.map((segment) => {
		if (segment.type === "html") {
			return <div class="cms-md" set:html={segment.html} />;
		}
		if (segment.type === "article-listing") {
			return (
				<ArticleListing
					count={segment.props.count}
					sort={segment.props.sort}
					layout={segment.props.layout}
					columns={segment.props.columns}
					gap={segment.props.gap}
					show={segment.props.show}
					imageStyle={segment.props.imageStyle}
					authorIds={segment.props.authors}
					categoryIds={segment.props.categories}
					tagIds={segment.props.tags}
					match={segment.props.match}
					linkable={segment.props.linkable}
				/>
			);
		}
		if (segment.type === "glossar-listing") {
			return (
				<GlossarListing
					count={segment.props.count}
					sort={segment.props.sort}
					layout={segment.props.layout}
					columns={segment.props.columns}
					gap={segment.props.gap}
					linkable={segment.props.linkable}
				/>
			);
		}
		if (segment.type === "tag-listing") {
			return (
				<TagListing
					count={segment.props.count}
					sort={segment.props.sort}
					layout={segment.props.layout}
					columns={segment.props.columns}
					gap={segment.props.gap}
				/>
			);
		}
		if (segment.type === "category-listing") {
			return (
				<CategoryListing
					count={segment.props.count}
					sort={segment.props.sort}
					layout={segment.props.layout}
					columns={segment.props.columns}
					gap={segment.props.gap}
				/>
			);
		}
		if (segment.type === "tag-cloud") {
			return <TagCloud />;
		}
		if (segment.type === "contact-email-flow") {
			return (
				<CmsContactEmailFlow
					layout={segment.layout}
					htmlBefore={segment.htmlBefore}
					htmlAfter={segment.htmlAfter}
				/>
			);
		}
		if (segment.type === "contact-email") {
			return (
				<div class="cms-md cms-contact-email cms-contact-email--block">
					<ContactEmail />
				</div>
			);
		}
		if (segment.type === "logo") {
			return (
				<CmsLogo
					variant={segment.props.variant}
					width={segment.props.width}
					unit={segment.props.unit}
					align={segment.props.align}
				/>
			);
		}
		if (segment.type === "separator") {
			return (
				<Separator
					height={segment.props.height}
					width={segment.props.width}
					color={segment.props.color}
					mark={segment.props.mark}
					markAlign={segment.props.markAlign}
					markSize={segment.props.markSize}
				/>
			);
		}
		if (segment.type === "spacer") {
			return <Spacer height={segment.props.height} />;
		}
		if (segment.type === "button") {
			return (
				<CmsButton
					label={segment.props.label}
					href={segment.props.href}
					target={segment.props.target}
					style={segment.props.style}
					color={segment.props.color}
					align={segment.props.align}
				/>
			);
		}
		if (segment.type === "button-group") {
			return (
				<CmsButtonGroup
					items={segment.props.items}
					layout={segment.props.layout}
					align={segment.props.align}
					fullWidthMobile={segment.props.fullWidthMobile}
				/>
			);
		}
		if (segment.type === "grid-cards") {
			return (
				<CmsGridCards
					colsDesktop={segment.props.colsDesktop}
					colsTablet={segment.props.colsTablet}
					colsMobile={segment.props.colsMobile}
					gap={segment.props.gap}
					stretchLast={segment.props.stretchLast}
					titleLevel={segment.props.titleLevel}
					cards={segment.props.cards}
				/>
			);
		}
		if (segment.type === "repodoc") {
			return <RepoDocLink {...segment.props} />;
		}
		if (segment.type === "video") {
			return (
				<VideoEmbed
					provider={segment.props.provider}
					id={segment.props.id}
					src={segment.props.src}
					title={segment.props.title}
					poster={segment.props.poster}
				/>
			);
		}
		if (segment.type === "member-video") {
			return (
				<MemberVideo
					src={segment.props.src}
					title={segment.props.title}
					poster={segment.props.poster}
				/>
			);
		}
		if (segment.type === "video-consent-reset") {
			return <VideoConsentReset />;
		}
		if (segment.type === "author-listing") {
			return <AuthorListing />;
		}
		if (segment.type === "author-social") {
			return (
				<AuthorSocialLinks
					authorId={segment.props.author || undefined}
					defaultAuthorId={defaultAuthorId}
				/>
			);
		}
		return null;
	})
}
