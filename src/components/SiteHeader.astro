---
import LogoMark from "./LogoMark.astro";
import SiteSearch from "./SiteSearch.astro";
import { getResolvedMenu, resolveOptionalMenuId } from "../lib/menus";
import { getPublicPages } from "../lib/pages";
import { stickyLogoDiffers } from "../lib/site-logo";
import { shellWidthClass } from "../cms/fields/content-width";
import { getSiteHeaderConfig, getSiteWebsiteTitle } from "../lib/site-config";

const pages = await getPublicPages();
const headerConfig = await getSiteHeaderConfig();
const headerMenuId = resolveOptionalMenuId(headerConfig.menu);
const menuItems = headerMenuId
	? await getResolvedMenu(headerMenuId, pages)
	: [];
const showMainNav = menuItems.length > 0;
const searchMode = headerConfig.search;
const showSearch = searchMode !== "off";
const showSearchTrigger = searchMode === "visible";
const websiteTitle = await getSiteWebsiteTitle();
const useStickyLogo = stickyLogoDiffers();
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const logoPosition = headerConfig.logoPosition;
const headerShellClass = shellWidthClass(headerConfig.contentWidth);

function isCurrent(href: string): boolean {
	const key = href.replace(/\/$/, "") || "/";
	return pathname === key;
}

const headerStyle = [
	`--header-h-desktop: ${headerConfig.heightDesktop}px`,
	`--header-h-tablet: ${headerConfig.heightTablet}px`,
	`--header-h-mobile: ${headerConfig.heightMobile}px`,
	`--header-min-h-desktop: ${headerConfig.minHeightDesktop}px`,
	`--header-min-h-tablet: ${headerConfig.minHeightTablet}px`,
	`--header-min-h-mobile: ${headerConfig.minHeightMobile}px`,
].join("; ");
---

{/*
  Height tokens on :root for scroll-padding (TOC/hash anchors under sticky bar).
*/}
<style is:global set:html={`:root { ${headerStyle} }`} />

{/*
  Sentinel above the sticky header: when it leaves the viewport, the bar is stuck
  and switches from Ruhehöhe (minHeight) to sticky height.
*/}
<div class="site-header-sticky-sentinel" data-header-sticky-sentinel aria-hidden="true"></div>
<header
	class:list={[
		"site-header",
		`site-header--logo-${logoPosition}`,
		headerConfig.stickyDesktop && "site-header--sticky-desktop",
		headerConfig.stickyTablet && "site-header--sticky-tablet",
		headerConfig.stickyMobile && "site-header--sticky-mobile",
	]}
	style={headerStyle}
	data-site-header
>
	<div class:list={["site-header__inner", "shell-inner", headerShellClass]}>
		<a class="site-header__brand" href="/" aria-label={`${websiteTitle} Startseite`}>
			<span class="site-header__logo-slot">
				<LogoMark
					variant="header"
					class:list={[
						"site-header__logo-mark",
						useStickyLogo && "site-header__logo-mark--rest",
					]}
				/>
				{
					useStickyLogo && (
						<LogoMark
							variant="headerSticky"
							class="site-header__logo-mark site-header__logo-mark--stuck"
						/>
					)
				}
			</span>
			<span class="site-header__logo-text">{websiteTitle}</span>
		</a>
		<div class="site-header__nav-cluster">
			{
				showMainNav && (
					<nav
						id="site-nav"
						class="site-nav"
						data-site-nav
						aria-label="Hauptnavigation"
					>
						<ul class="site-nav__list list-plain">
							{menuItems.map((item, index) => {
								const current = !item.external && isCurrent(item.href);
								const hasChildren = item.children.length > 0;
								const subId = `site-nav-sub-${index}`;
								return (
									<li
										class:list={{
											"site-nav__item": true,
											"has-children": hasChildren,
										}}
										data-nav-item={hasChildren ? "" : undefined}
									>
										<div class="site-nav__item-row">
											<a
												href={item.href}
												class:list={item.cssClasses}
												aria-current={current ? "page" : undefined}
												target={item.external ? "_blank" : undefined}
												rel={
													item.external ? "noopener noreferrer" : undefined
												}
											>
												{item.label}
											</a>
											{hasChildren && (
												<button
													type="button"
													class="site-nav__sub-toggle"
													data-nav-sub-toggle
													aria-expanded="false"
													aria-controls={subId}
													aria-label={`Untermenü ${item.label}`}
												>
													<span
														class="site-nav__chevron"
														aria-hidden="true"
													/>
												</button>
											)}
										</div>
										{hasChildren && (
											<ul
												id={subId}
												class="site-nav__sub list-plain"
												data-nav-sub
											>
												{item.children.map((child) => {
													const childCurrent =
														!child.external && isCurrent(child.href);
													return (
														<li>
															<a
																href={child.href}
																class:list={child.cssClasses}
																aria-current={
																	childCurrent ? "page" : undefined
																}
																target={
																	child.external ? "_blank" : undefined
																}
																rel={
																	child.external
																		? "noopener noreferrer"
																		: undefined
																}
															>
																{child.label}
															</a>
														</li>
													);
												})}
											</ul>
										)}
									</li>
								);
							})}
						</ul>
					</nav>
				)
			}
			{
				showSearch && (
					<div
						class:list={[
							"site-header__search",
							!showSearchTrigger && "site-header__search--hidden",
						]}
					>
						<SiteSearch showTrigger={showSearchTrigger} />
					</div>
				)
			}
		</div>
		{
			showMainNav && (
				<div class="site-header__actions">
					<button
						type="button"
						class="site-nav-toggle"
						data-nav-toggle
						aria-expanded="false"
						aria-controls="site-nav"
						aria-label="Menü öffnen"
					>
						<span class="site-nav-toggle__bars" aria-hidden="true">
							<span class="site-nav-toggle__bar"></span>
							<span class="site-nav-toggle__bar"></span>
							<span class="site-nav-toggle__bar"></span>
						</span>
					</button>
				</div>
			)
		}
	</div>
</header>

<script>
	import "../scripts/nav-toggle";
	import "../scripts/nav-submenu";
	import "../scripts/header-sticky";
</script>

<style is:global>
	/*
	  Global (not scoped): sticky must win over page-bg stacking rules,
	  and height tokens must apply at every viewport without attribute scoping quirks.
	*/
	.site-header-sticky-sentinel {
		height: 1px;
		margin: 0;
		padding: 0;
		overflow: hidden;
		pointer-events: none;
		visibility: hidden;
	}

	.site-header {
		--header-bar-height: var(--header-h-desktop, 64px);
		--header-bar-min-height: var(--header-min-h-desktop, 64px);
		position: relative;
		z-index: 20;
		background: var(--color-chrome);
		border-bottom: 1px solid var(--color-border);
	}

	.site-header__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.5rem;
		/* Ruhehöhe / ohne Sticky: min-height (darf wachsen). Sticky+stuck: feste Höhe. */
		min-height: var(--header-bar-min-height);
		height: auto;
		padding-block: 0;
		box-sizing: border-box;
		transition:
			min-height 0.28s ease,
			height 0.28s ease;
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header__inner {
			transition: none;
		}
	}

	/* Breakpoints: same px as --bp-tablet / --bp-mobile (docs/design). */
	@media (max-width: 1023px) {
		.site-header {
			--header-bar-height: var(--header-h-tablet, 64px);
			--header-bar-min-height: var(--header-min-h-tablet, 64px);
		}
	}

	@media (max-width: 679px) {
		.site-header {
			--header-bar-height: var(--header-h-mobile, 56px);
			--header-bar-min-height: var(--header-min-h-mobile, 56px);
		}
	}

	@media (min-width: 1024px) {
		.site-header.site-header--sticky-desktop {
			position: sticky;
			/* Offset when Wartungsmodus-Banner sticky is oben (dev). */
			top: var(--maintenance-dev-banner-h, 0px);
		}

		/* Explicit px heights so Ruhe → sticky animates (auto → px does not). */
		.site-header.site-header--sticky-desktop .site-header__inner {
			min-height: var(--header-bar-min-height);
			height: var(--header-bar-min-height);
		}

		.site-header.site-header--sticky-desktop.is-stuck .site-header__inner {
			min-height: var(--header-bar-height);
			height: var(--header-bar-height);
		}
	}

	@media (max-width: 1023px) and (min-width: 680px) {
		.site-header.site-header--sticky-tablet {
			position: sticky;
			top: var(--maintenance-dev-banner-h, 0px);
		}

		.site-header.site-header--sticky-tablet .site-header__inner {
			min-height: var(--header-bar-min-height);
			height: var(--header-bar-min-height);
		}

		.site-header.site-header--sticky-tablet.is-stuck .site-header__inner {
			min-height: var(--header-bar-height);
			height: var(--header-bar-height);
		}
	}

	@media (max-width: 679px) {
		.site-header.site-header--sticky-mobile {
			position: sticky;
			top: var(--maintenance-dev-banner-h, 0px);
		}

		.site-header.site-header--sticky-mobile .site-header__inner {
			min-height: var(--header-bar-min-height);
			height: var(--header-bar-min-height);
		}

		.site-header.site-header--sticky-mobile.is-stuck .site-header__inner {
			min-height: var(--header-bar-height);
			height: var(--header-bar-height);
		}
	}

	/*
	  Centered logo = two rows from tablet up. Single-row CMS heights would clip
	  or leave no air; grow with content and add vertical padding.
	*/
	@media (min-width: 680px) {
		.site-header--logo-center .site-header__inner,
		.site-header--logo-center.site-header--sticky-desktop .site-header__inner,
		.site-header--logo-center.site-header--sticky-desktop.is-stuck .site-header__inner,
		.site-header--logo-center.site-header--sticky-tablet .site-header__inner,
		.site-header--logo-center.site-header--sticky-tablet.is-stuck .site-header__inner {
			min-height: 0;
			height: auto;
			padding-block: 0.75rem;
		}
	}
</style>

<style>

	.site-header__brand {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-weight: var(--font-weight-heading);
		font-size: 1.125rem;
		color: var(--color-text);
		line-height: 1;
		text-decoration: none;
	}

	.site-header__brand:hover .site-header__logo-text,
	.site-header__brand:focus-visible .site-header__logo-text {
		color: var(--color-action);
	}

	.site-header__logo-slot {
		display: grid;
		flex-shrink: 0;
		width: 1.35rem;
		height: 1.35rem;
	}

	.site-header__brand :global(.site-header__logo-mark) {
		display: block;
		grid-area: 1 / 1;
		width: 1.35rem;
		height: 1.35rem;
	}

	.site-header__brand :global(.site-header__logo-mark--stuck) {
		display: none;
	}

	.site-header.is-stuck :global(.site-header__logo-mark--rest) {
		display: none;
	}

	.site-header.is-stuck :global(.site-header__logo-mark--stuck) {
		display: block;
	}

	.site-header__actions {
		display: flex;
		align-items: center;
		gap: 0.15rem;
		flex-shrink: 0;
	}

	/* Menu + search; search always follows the items (#74). */
	.site-header__nav-cluster {
		display: flex;
		align-items: center;
		gap: 0.35rem 0.75rem;
		margin-inline-start: auto;
		min-width: 0;
	}

	.site-header__search {
		display: flex;
		align-items: center;
		flex-shrink: 0;
	}

	/* Logo right: menu+search leading, brand trailing (#74). */
	@media (min-width: 680px) {
		.site-header--logo-right .site-header__nav-cluster {
			order: 1;
			margin-inline-start: 0;
			margin-inline-end: auto;
		}

		.site-header--logo-right .site-header__actions {
			order: 2;
		}

		.site-header--logo-right .site-header__brand {
			order: 3;
		}
	}

	/* Logo center: brand row + menu/search row below (#74). */
	@media (min-width: 680px) {
		.site-header--logo-center .site-header__inner {
			display: grid;
			grid-template-columns: 1fr auto 1fr;
			grid-template-areas:
				"lead brand trail"
				"nav nav nav";
			align-items: center;
			column-gap: 1rem;
			row-gap: 0.5rem;
		}

		.site-header--logo-center .site-header__brand {
			grid-area: brand;
			justify-self: center;
		}

		.site-header--logo-center .site-header__actions {
			grid-area: trail;
			justify-self: end;
		}

		.site-header--logo-center .site-header__nav-cluster {
			grid-area: nav;
			margin-inline-start: 0;
			justify-content: center;
			width: 100%;
		}

		.site-header--logo-center .site-nav__list {
			justify-content: center;
		}
	}

	.site-nav-toggle {
		display: none;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		margin: 0;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: transparent;
		color: var(--color-text);
		cursor: pointer;
	}

	.site-nav-toggle:hover {
		color: var(--color-action-hover);
	}

	.site-nav-toggle:focus-visible {
		color: var(--color-action-hover);
		outline: 2px solid var(--color-action);
		outline-offset: 2px;
	}

	.site-nav-toggle__bars {
		position: relative;
		display: block;
		width: 1.35rem;
		height: 1rem;
	}

	.site-nav-toggle__bar {
		position: absolute;
		left: 0;
		display: block;
		width: 100%;
		height: 2px;
		background: currentColor;
		transition:
			transform 0.22s ease,
			opacity 0.22s ease,
			top 0.22s ease;
	}

	.site-nav-toggle__bar:nth-child(1) {
		top: 0;
	}

	.site-nav-toggle__bar:nth-child(2) {
		top: calc(50% - 1px);
	}

	.site-nav-toggle__bar:nth-child(3) {
		top: calc(100% - 2px);
	}

	.site-header.is-nav-open .site-nav-toggle__bar:nth-child(1) {
		top: calc(50% - 1px);
		transform: rotate(45deg);
	}

	.site-header.is-nav-open .site-nav-toggle__bar:nth-child(2) {
		opacity: 0;
		transform: scaleX(0);
	}

	.site-header.is-nav-open .site-nav-toggle__bar:nth-child(3) {
		top: calc(50% - 1px);
		transform: rotate(-45deg);
	}

	.site-nav__list {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.25rem;
	}

	.site-nav__item-row {
		display: flex;
		align-items: center;
		gap: 0.2rem;
	}

	.site-nav__sub-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.75rem;
		height: 1.75rem;
		margin: 0;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: transparent;
		color: var(--color-text-muted);
		cursor: pointer;
	}

	.site-nav__sub-toggle:hover,
	.site-nav__sub-toggle:focus-visible {
		color: var(--color-action);
	}

	.site-nav__sub-toggle:focus-visible {
		outline: 2px solid var(--color-action);
		outline-offset: 2px;
	}

	.site-nav__chevron {
		display: block;
		width: 0.45rem;
		height: 0.45rem;
		border-right: 1.5px solid currentColor;
		border-bottom: 1.5px solid currentColor;
		transform: rotate(45deg) translateY(-1px);
		transition: transform 0.2s ease;
	}

	.site-nav__item.is-sub-open .site-nav__chevron {
		transform: rotate(225deg) translateY(-1px);
	}

	.site-nav__sub {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-nav a[aria-current="page"] {
		color: var(--color-text);
	}

	/* Desktop: flyout dropdown */
	@media (min-width: 680px) {
		.site-nav-toggle {
			display: none;
		}

		.site-nav__item {
			position: relative;
		}

		/* Keep hover bridge to submenu (no gap that kills :hover). */
		.site-nav__item.has-children {
			padding-bottom: 0.45rem;
			margin-bottom: -0.45rem;
		}

		.site-nav__sub {
			position: absolute;
			top: 100%;
			/* Grow left from the item so right-edge menus don't widen the page */
			right: 0;
			left: auto;
			z-index: 40;
			min-width: 11rem;
			padding: 0.4rem 0;
			background: var(--color-submenu-bg);
			border: 1px solid var(--color-border);
			visibility: hidden;
			opacity: 0;
			pointer-events: none;
			/* Do not use overflow:hidden — it clips the ::before hover bridge */
			transition:
				opacity 0.15s ease,
				visibility 0.15s;
		}

		/* Invisible hit area above the panel so the cursor can reach it. */
		.site-nav__sub::before {
			content: "";
			position: absolute;
			left: 0;
			right: 0;
			bottom: 100%;
			height: 0.5rem;
		}

		.site-nav__sub a {
			display: block;
			padding: 0.45rem 0.9rem;
			font-size: 0.95em;
			color: var(--color-submenu-text);
			white-space: nowrap;
		}

		.site-nav__sub a:hover,
		.site-nav__sub a:focus-visible {
			color: var(--color-action);
			background: var(--color-action-muted);
		}

		.site-nav__item:hover .site-nav__sub,
		.site-nav__item:focus-within .site-nav__sub,
		.site-nav__item.is-sub-open .site-nav__sub {
			visibility: visible;
			opacity: 1;
			pointer-events: auto;
		}

		.site-nav__item:hover .site-nav__chevron,
		.site-nav__item:focus-within .site-nav__chevron,
		.site-nav__item.is-sub-open .site-nav__chevron {
			transform: rotate(225deg) translateY(-1px);
		}
	}

	/* Mobile: accordion under parent */
	@media (max-width: 679px) {
		.site-header {
			border-bottom: none;
		}

		/*
		  overflow:hidden / body scroll-lock breaks position:sticky — while the
		  menu is open, pin the bar to the viewport so it stays visible.
		*/
		.site-header.is-nav-open {
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			width: 100%;
		}

		.site-header__inner {
			flex-wrap: nowrap;
			border-bottom: 1px solid var(--color-border);
		}

		/* Nav is a dropdown; search stays in the bar after (visual: before burger). */
		.site-header__nav-cluster {
			margin-inline-start: auto;
		}

		.site-header__actions {
			margin-inline-start: 0;
		}

		/* Logo right: Burger, Lupe, … Logo */
		.site-header--logo-right .site-header__actions {
			order: 1;
		}

		.site-header--logo-right .site-header__nav-cluster {
			order: 2;
			margin-inline-start: 0;
		}

		.site-header--logo-right .site-header__brand {
			order: 3;
			margin-inline-start: auto;
		}

		/* Logo center: Lupe + Burger rechts, Logo optisch mittig */
		.site-header--logo-center .site-header__inner {
			position: relative;
			justify-content: flex-end;
		}

		.site-header--logo-center .site-header__nav-cluster {
			margin-inline-start: 0;
		}

		.site-header--logo-center .site-header__brand {
			position: absolute;
			left: 50%;
			transform: translateX(-50%);
		}

		.site-nav-toggle {
			display: inline-flex;
			flex-shrink: 0;
		}

		.site-nav {
			position: absolute;
			top: 100%;
			/* Stretch to header edges — avoid 100vw (scrollbar overflow) */
			left: 0;
			right: 0;
			z-index: 30;
			width: auto;
			margin: 0;
			padding: 0.5rem var(--shell-padding-inline);
			background: var(--color-chrome);
			border-bottom: 1px solid var(--color-border);
			visibility: hidden;
			opacity: 0;
			pointer-events: none;
			transform: translateY(-0.35rem);
			transition:
				opacity 0.22s ease,
				transform 0.22s ease,
				visibility 0.22s;
		}

		.site-header.is-nav-open .site-nav {
			visibility: visible;
			opacity: 1;
			pointer-events: auto;
			transform: translateY(0);
		}

		.site-nav__list {
			flex-direction: column;
			flex-wrap: nowrap;
			align-items: stretch;
			gap: 0;
		}

		.site-nav__list > li + li {
			border-top: 1px solid var(--color-border);
		}

		.site-nav__item-row {
			justify-content: space-between;
		}

		.site-nav__item-row > a {
			flex: 1;
			padding: 0.75rem 0;
		}

		.site-nav__chevron {
			width: 0.75rem;
			height: 0.75rem;
			transform: rotate(45deg) translateY(-0.15rem);
		}

		.site-nav__item.is-sub-open .site-nav__chevron {
			transform: rotate(225deg) translateY(-0.15rem);
		}

		.site-nav__sub {
			display: none;
			padding: 0 0 0.5rem 0.75rem;
			border-top: 1px solid var(--color-border);
		}

