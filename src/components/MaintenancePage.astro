---
import LogoMark from "./LogoMark.astro";

interface Props {
	title: string;
	descriptionHtml?: string;
	/** Show logo above the title (CMS Wartungsmodus → Logo). */
	showLogo?: boolean;
	/** Optional media path; empty = General → Logos → Header. */
	logoCmsPath?: string;
	/** Logo width in px (default 300). */
	logoSize?: number;
}

const {
	title,
	descriptionHtml,
	showLogo = false,
	logoCmsPath,
	logoSize = 300,
} = Astro.props;

const logoWidth = Math.min(600, Math.max(24, Math.round(logoSize)));
/** Variable + concrete width so size always wins over stylesheet defaults. */
const logoStyle = [
	`--maintenance-logo-size: ${logoWidth}px`,
	`width: min(100%, ${logoWidth}px)`,
].join("; ");
---

<main class="maintenance">
	<div class="maintenance__inner">
		{
			showLogo && (
				<div class="maintenance__logo" style={logoStyle}>
					<LogoMark
						variant="header"
						cmsPath={logoCmsPath}
						class="maintenance__logo-mark"
					/>
				</div>
			)
		}
		<h1 class="maintenance__title">{title}</h1>
		{
			descriptionHtml ? (
				<div class="maintenance__body cms-md" set:html={descriptionHtml} />
			) : null
		}
	</div>
</main>

<style>
	.maintenance {
		flex: 1 0 auto;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 0;
		padding: 2rem var(--shell-padding-inline);
		text-align: center;
	}

	.maintenance__inner {
		width: min(36rem, 100%);
	}

	.maintenance__logo {
		display: flex;
		justify-content: center;
		margin: 0 auto 1.25rem;
		max-width: 100%;
		/* width comes from inline style (CMS size); keep var for children */
	}

	.maintenance__logo :global(.maintenance__logo-mark),
	.maintenance__logo :global(.logo-mark) {
		display: block;
		width: 100%;
		max-width: 100%;
		height: auto;
	}

	.maintenance__logo :global(.logo-mark svg),
	.maintenance__logo :global(.logo-mark img) {
		display: block;
		width: 100%;
		max-width: 100%;
		height: auto;
	}

	.maintenance__title {
		margin: 0 0 1rem;
		font-family: var(--font-heading);
		font-weight: var(--font-weight-heading);
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		line-height: 1.2;
	}

	.maintenance__body {
		margin: 0;
		color: var(--color-text);
		font-size: 1.05rem;
		line-height: 1.65;
	}

	.maintenance__body :global(> :first-child) {
		margin-top: 0;
	}

	.maintenance__body :global(> :last-child) {
		margin-bottom: 0;
	}
</style>
