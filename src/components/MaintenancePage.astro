---
interface Props {
	title: string;
	descriptionHtml?: string;
}

const { title, descriptionHtml } = Astro.props;
---

<main class="maintenance">
	<div class="maintenance__inner">
		<h1 class="maintenance__title">{title}</h1>
		{
			descriptionHtml ? (
				<div class="maintenance__body cms-md" set:html={descriptionHtml} />
			) : null
		}
	</div>
</main>

<style>
	.maintenance {
		flex: 1 0 auto;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 0;
		padding: 2rem var(--shell-padding-inline);
		text-align: center;
	}

	.maintenance__inner {
		width: min(36rem, 100%);
	}

	.maintenance__title {
		margin: 0 0 1rem;
		font-family: var(--font-heading);
		font-weight: var(--font-weight-heading);
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		line-height: 1.2;
	}

	.maintenance__body {
		margin: 0;
		color: var(--color-text);
		font-size: 1.05rem;
		line-height: 1.65;
	}

	.maintenance__body :global(> :first-child) {
		margin-top: 0;
	}

	.maintenance__body :global(> :last-child) {
		margin-bottom: 0;
	}
</style>
