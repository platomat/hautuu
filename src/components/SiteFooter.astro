---
import LogoMark from "./LogoMark.astro";
import { getResolvedMenu, resolveOptionalMenuId } from "../lib/menus";
import { withBuildId } from "../lib/build-id";
import {
	classifyAttribution,
	sanitizeSoftHtml,
} from "../cms/fields/page-background";
import { getPublicPages } from "../lib/pages";
import { shellWidthClass } from "../cms/fields/content-width";
import {
	getFooterBarConfig,
	getFooterBrandConfig,
	getFooterCopyrightConfig,
	getSiteConfig,
	getSiteWebsiteDescription,
	getSiteWebsiteTitle,
} from "../lib/site-config";

interface Props {
	/** Copyright bar only (no brand strip). Used by maintenance screen. */
	copyrightOnly?: boolean;
}

const { copyrightOnly = false } = Astro.props;

const websiteTitle = await getSiteWebsiteTitle();
const footerCopyright = getFooterCopyrightConfig();
const startYear = footerCopyright.startYear;
const currentYear = new Date().getFullYear();
const copyrightYears =
	currentYear > startYear ? `${startYear}-${currentYear}` : String(startYear);
const claimRaw = footerCopyright.claim.trim();
const claimKind = claimRaw ? classifyAttribution(claimRaw) : null;
// Soft HTML (a, b, strong, em, i, br) — not stock-photo allowlist (a only).
const claimHtml = claimKind === "html" ? sanitizeSoftHtml(claimRaw) : "";
const showClaim = Boolean(claimRaw);
const claimSeparator = footerCopyright.separator;
const showCenterLogo = footerCopyright.showCenterLogo !== false;

const general = getSiteConfig().general;
const githubRepo = general?.githubRepo?.trim() ?? "";
const showGithub = showCenterLogo && Boolean(githubRepo);
const showHomeLogo = showCenterLogo && !showGithub;
const repoUrl = showGithub
	? `https://github.com/${githubRepo.replace(/^\/+|\/+$/g, "")}/`
	: "";
const repoTitle = showGithub
	? `${websiteTitle} auf GitHub (${githubRepo.replace(/^\/+|\/+$/g, "")})`
	: "";
const homeLabel = `${websiteTitle} Startseite`;

const pages = await getPublicPages();
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const brand = getFooterBrandConfig();
const footerBar = getFooterBarConfig();
const legalMenuId = resolveOptionalMenuId(footerBar.menu);
const legalItems = legalMenuId
	? await getResolvedMenu(legalMenuId, pages)
	: [];
const brandShellClass = shellWidthClass(brand.contentWidth);
const barShellClass = shellWidthClass(footerBar.contentWidth);
const brandDescriptionRaw = getSiteWebsiteDescription();
const brandDescriptionHtml = brandDescriptionRaw
	? sanitizeSoftHtml(brandDescriptionRaw)
	: "";
const brandMenuId = resolveOptionalMenuId(brand.menu);
const brandMenuItems =
	brand.enabled && brandMenuId
		? await getResolvedMenu(brandMenuId, pages)
		: [];

const brandBlocks =
	!copyrightOnly && brand.enabled
		? brand.blocks.filter((block) => {
				if (!block.enabled) return false;
				if (block.id === "description") return Boolean(brandDescriptionHtml);
				if (block.id === "menu") return brandMenuItems.length > 0;
				return true;
			})
		: [];
const showBrand = brandBlocks.length > 0;
const brandLogoSize = Math.min(160, Math.max(24, brand.logoSize || 44));
const brandStyle = showBrand
	? `--footer-brand-logo-size: ${brandLogoSize}px`
	: undefined;
const barBorderWidth =
	footerBar.borderWidth === "shell" ? "shell" : "full";

function isCurrent(href: string): boolean {
	const key = href.replace(/\/$/, "") || "/";
	return pathname === key;
}
---

<footer
	class:list={[
		"site-footer",
		showBrand && "site-footer--has-brand",
		`site-footer--bar-border-${barBorderWidth}`,
	]}
	style={brandStyle}
>
	{
		showBrand && (
			<div class="site-footer__brand">
				<div
					class:list={[
						"shell-inner",
						brandShellClass,
						"site-footer__brand-inner",
						`site-footer__brand-inner--${brand.direction}`,
						`site-footer__brand-inner--align-${brand.align}`,
					]}
				>
					{brandBlocks.map((block) => {
						if (block.id === "logo") {
							return (
								<a
									class="site-footer__brand-logo"
									href="/"
									title={homeLabel}
									aria-label={homeLabel}
								>
									<LogoMark
										variant="footer"
										class="site-footer__brand-mark"
									/>
								</a>
							);
						}
						if (block.id === "description") {
							return (
								<div
									class="site-footer__brand-desc text-sm text-muted"
									set:html={brandDescriptionHtml}
								/>
							);
						}
						return (
							<nav
								class="site-footer__brand-nav"
								aria-label="Footer"
							>
								<ul
									class:list={[
										"site-footer__brand-menu",
										`site-footer__brand-menu--${brand.menuLayout}`,
										"list-plain",
										"text-sm",
									]}
								>
									{brandMenuItems.map((item) => {
										const current =
											!item.external && isCurrent(item.href);
										return (
											<li>
												<a
													href={item.href}
													class:list={item.cssClasses}
													aria-current={
														current ? "page" : undefined
													}
													target={
														item.external
															? "_blank"
															: undefined
													}
													rel={
														item.external
															? "noopener noreferrer"
															: undefined
													}
												>
													{item.label}
												</a>
											</li>
										);
									})}
								</ul>
							</nav>
						);
					})}
				</div>
			</div>
		)
	}
	<div
		class:list={[
			"site-footer__bar",
			`site-footer__bar--border-${barBorderWidth}`,
		]}
	>
		<div class:list={["shell-inner", barShellClass, "site-footer__bar-inner"]}>
			<p class="site-footer__copy text-sm text-muted">
				<span>© {copyrightYears}</span>
				{" "}
				<span>
					<strong class="site-footer__site-name">{websiteTitle}</strong>
					{
						showClaim && (
							<>
								{" "}
								<span class="site-footer__sep" aria-hidden="true">
									{claimSeparator}
								</span>{" "}
								{
									claimKind === "html" ? (
										<span
											class="site-footer__claim"
											set:html={claimHtml}
										/>
									) : claimKind === "url" ? (
										<a
											class="site-footer__claim"
											href={claimRaw}
											rel="noopener noreferrer"
											target="_blank"
										>
											{claimRaw}
										</a>
									) : (
										<span class="site-footer__claim">{claimRaw}</span>
									)
								}
							</>
						)
					}
				</span>
			</p>
			{
				showGithub ? (
					<a
						class="site-footer__center site-footer__github"
						href={repoUrl}
						title={repoTitle}
						aria-label={repoTitle}
						target="_blank"
						rel="noopener noreferrer"
					>
						<img
							src={withBuildId("/img/github.svg")}
							alt=""
							width="28"
							height="28"
							decoding="async"
						/>
					</a>
				) : showHomeLogo ? (
					<a
						class="site-footer__center site-footer__home"
						href="/"
						title={homeLabel}
						aria-label={homeLabel}
					>
						<LogoMark variant="footer" class="site-footer__home-mark" />
					</a>
				) : (
					<span class="site-footer__center" aria-hidden="true" />
				)
			}
			{
				legalItems.length > 0 ? (
					<nav class="site-footer__legal" aria-label="Rechtliches">
						<ul class="flex-row flex-align-baseline gap-md list-plain text-sm">
							{legalItems.map((item) => {
								const current = !item.external && isCurrent(item.href);
								return (
									<li>
										<a
											href={item.href}
											class:list={item.cssClasses}
											aria-current={current ? "page" : undefined}
											target={item.external ? "_blank" : undefined}
											rel={item.external ? "noopener noreferrer" : undefined}
										>
											{item.label}
										</a>
									</li>
								);
							})}
						</ul>
					</nav>
				) : (
					<span class="site-footer__legal" aria-hidden="true" />
				)
			}
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: auto;
		background: var(--color-chrome);
	}

	/* Brand strip: no top border on outer footer; chrome via gradient (global.css). */
	.site-footer--has-brand {
		background: transparent;
	}
</style>
