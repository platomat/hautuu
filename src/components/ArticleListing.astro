---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Icon from "./Icon.astro";
import {
	formatArticleDate,
	getArticleHref,
	getArticlesByIds,
	getFilteredArticles,
	getPublishedArticles,
	type ArticleFilterMatch,
	type ArticleSort,
} from "../lib/articles";
import {
	getAuthorHref,
	type AuthorEntry,
} from "../lib/authors";
import {
	getCategoryHref,
	type CategoryEntry,
} from "../lib/categories";
import { resolveCmsImage } from "../lib/cms-image";
import {
	normalizeArticleCardShowList,
	parseArticleCardShow,
	parseArticleListingImageStyle,
	type ArticleCardField,
	type ArticleListingImageStyle,
} from "../lib/content-embeds";
import {
	estimateReadingTimeMinutes,
	formatReadingTime,
} from "../lib/reading-time";
import { formatTagHashtag, getTagHref, type TagEntry } from "../lib/tags";

interface Props {
	count?: number;
	sort?: ArticleSort;
	layout?: "grid" | "list";
	columns?: number;
	/** Gap between items, in rem (grid and list). */
	gap?: number;
	/** Card fields: displayTitle, displayIntro, displayCategories, … */
	show?: ArticleCardField[] | string;
	/** Preview image layout when `displayImage` is on. */
	imageStyle?: ArticleListingImageStyle;
	/** Only these article slugs, in listed order (published only). */
	articleIds?: string[];
	/** Only articles with this tag (`count === 0` → all matches). */
	tagId?: string;
	/** Tag slugs (any of these). Combined with `tagId` if both set. */
	tagIds?: string[];
	/** Only articles with this category (`count === 0` → all matches). */
	categoryId?: string;
	/** Category slugs (any of these). Combined with `categoryId` if both set. */
	categoryIds?: string[];
	/** Only articles with this author (`count === 0` → all matches). */
	authorId?: string;
	/** Author slugs (any of these). Combined with `authorId` if both set. */
	authorIds?: string[];
	/**
	 * Between filter groups: `all` (default) or `any`.
	 * Within a group, one matching slug is enough.
	 */
	match?: ArticleFilterMatch;
	/** Link title/preview to the article page (default true). */
	linkable?: boolean;
	/** Less vertical margin (e.g. glossar related block). */
	compact?: boolean;
}

const {
	count = 3,
	sort = "newest",
	layout = "grid",
	columns = 3,
	gap = 1.25,
	show: showProp,
	imageStyle: imageStyleProp = "top-cover",
	articleIds,
	tagId,
	tagIds: tagIdsProp,
	categoryId,
	categoryIds: categoryIdsProp,
	authorId,
	authorIds: authorIdsProp,
	match = "all",
	linkable = true,
	compact = false,
} = Astro.props;

const imageStyle = parseArticleListingImageStyle(imageStyleProp);

function mergeIds(
	list: string[] | undefined,
	single: string | undefined,
): string[] {
	const seen = new Set<string>();
	const out: string[] = [];
	for (const raw of [...(list ?? []), ...(single ? [single] : [])]) {
		const id = raw.trim();
		if (!id || seen.has(id)) continue;
		seen.add(id);
		out.push(id);
	}
	return out;
}

const resolvedAuthorIds = mergeIds(authorIdsProp, authorId);
const resolvedCategoryIds = mergeIds(categoryIdsProp, categoryId);
const resolvedTagIds = mergeIds(tagIdsProp, tagId);
const hasFilters =
	resolvedAuthorIds.length > 0 ||
	resolvedCategoryIds.length > 0 ||
	resolvedTagIds.length > 0;

const showFields = new Set(
	typeof showProp === "string"
		? parseArticleCardShow(showProp)
		: showProp?.length
			? normalizeArticleCardShowList(showProp)
			: parseArticleCardShow(undefined),
);

const showImage = showFields.has("displayImage");
const showTitle = showFields.has("displayTitle");
const showIntro = showFields.has("displayIntro");
const showDate = showFields.has("displayDate");
const showReadingTime = showFields.has("displayReadingTime");
const showCategories = showFields.has("displayCategories");
const showTags = showFields.has("displayTags");
const showAuthors = showFields.has("displayAuthors");
const showTaxonomies = showCategories || showTags;
const showMeta = showDate || showReadingTime || showTaxonomies || showAuthors;

/** `count === 0` → all published articles (or all matching filters). */
const listingLimit = count === 0 ? undefined : count;
const articles = articleIds?.length
	? await getArticlesByIds(articleIds)
	: hasFilters
		? await getFilteredArticles(
				{
					authorIds: resolvedAuthorIds,
					categoryIds: resolvedCategoryIds,
					tagIds: resolvedTagIds,
					match,
				},
				{ sort, limit: listingLimit },
			)
		: await getPublishedArticles({
				sort,
				limit: listingLimit,
			});
const [tags, categories, authors] = await Promise.all([
	getCollection("tags"),
	getCollection("categories"),
	getCollection("authors"),
]);
const tagMap = new Map(tags.map((tag) => [tag.id, tag]));
const categoryMap = new Map(categories.map((cat) => [cat.id, cat]));
const authorMap = new Map(authors.map((author) => [author.id, author]));
const col = Math.min(4, Math.max(1, columns));
const gapRem = Math.min(8, Math.max(0, gap));

/** Titelbild first, else Seitenhintergrund (#95). */
function previewImageFor(article: (typeof articles)[number]) {
	const entryDir = `content/articles/${article.id}/`;
	return (
		resolveCmsImage(article.data.heroImage, entryDir) ||
		resolveCmsImage(article.data.background?.image, entryDir)
	);
}

function tagsFor(article: (typeof articles)[number]): TagEntry[] {
	return (article.data.tags ?? [])
		.map((id) => tagMap.get(id))
		.filter((tag): tag is TagEntry => Boolean(tag))
		.sort((a, b) =>
			a.data.title.localeCompare(b.data.title, "de", { sensitivity: "base" }),
		);
}

function categoriesFor(article: (typeof articles)[number]): CategoryEntry[] {
	return (article.data.categories ?? [])
		.map((id) => categoryMap.get(id))
		.filter((cat): cat is CategoryEntry => Boolean(cat))
		.sort((a, b) =>
			a.data.title.localeCompare(b.data.title, "de", { sensitivity: "base" }),
		);
}

function authorsFor(article: (typeof articles)[number]): AuthorEntry[] {
	return (article.data.authors ?? [])
		.map((id) => authorMap.get(id))
		.filter((author): author is AuthorEntry => Boolean(author));
}
---

{
	articles.length === 0 ? (
		<p>Noch keine veröffentlichten Artikel.</p>
	) : (
		<section
			class:list={[
				"article-listing",
				layout === "list" ? "article-listing--list" : "article-listing--grid",
				compact && "article-listing--compact",
				showImage && `article-listing--image-${imageStyle}`,
				linkable ? "article-listing--linkable" : "article-listing--nolink",
			]}
			style={`--article-listing-cols: ${col}; --article-listing-gap: ${gapRem}rem`}
			aria-label="Artikel"
		>
			<ul class="article-listing__list list-plain">
				{articles.map((article) => {
					const articleTags = tagsFor(article);
					const articleCategories = categoriesFor(article);
					const articleAuthors = authorsFor(article);
					const minutes = estimateReadingTimeMinutes(article.body);
					const readingLabel = formatReadingTime(minutes);
					const hasCategories =
						showCategories && articleCategories.length > 0;
					const hasTags = showTags && articleTags.length > 0;
					const hasAuthors = showAuthors && articleAuthors.length > 0;
					const previewImage = showImage ? previewImageFor(article) : undefined;
					const href = getArticleHref(article);
					const copyInner = (
						<span class="article-listing__copy">
							{showTitle && (
								<h2 class="article-listing__title">{article.data.title}</h2>
							)}
							{showIntro && article.data.summary && (
								<p class="article-listing__summary text-sm text-muted">
									{article.data.summary}
								</p>
							)}
							{!showTitle && !showIntro && (
								<span class="visually-hidden">{article.data.title}</span>
							)}
						</span>
					);
					return (
						<li class="article-listing__item">
							<div class="article-listing__layout">
								{previewImage &&
									(linkable ? (
										<a
											class="article-listing__media"
											href={href}
											tabindex={-1}
											aria-hidden="true"
										>
											<Image
												class="article-listing__image"
												src={previewImage}
												alt=""
												widths={[320, 480, 640]}
												sizes="(max-width: 679px) 100vw, (max-width: 1023px) 50vw, 33vw"
											/>
										</a>
									) : (
										<div class="article-listing__media" aria-hidden="true">
											<Image
												class="article-listing__image"
												src={previewImage}
												alt=""
												widths={[320, 480, 640]}
												sizes="(max-width: 679px) 100vw, (max-width: 1023px) 50vw, 33vw"
											/>
										</div>
									))}
								<div class="article-listing__body">
									{linkable ? (
										<a class="article-listing__link" href={href}>
											{copyInner}
										</a>
									) : (
										<div class="article-listing__main">{copyInner}</div>
									)}
									{showMeta && (
										<div class="article-listing__meta text-sm text-muted">
											{(hasCategories || hasTags) && (
												<div class="article-listing__taxonomies">
													{hasCategories && (
														<p class="article-listing__categories">
															{articleCategories.map((cat, index) => (
																<>
																	{index > 0 && " "}
																	<a
																		class="article-categories__link"
																		href={getCategoryHref(cat)}
																	>
																		<Icon
																			name="category"
																			class="article-categories__icon"
																		/>
																		{cat.data.title}
																	</a>
																</>
															))}
														</p>
													)}
													{hasTags && (
														<p class="article-listing__tags">
															{articleTags.map((tag, index) => (
																<>
																	{index > 0 && " "}
																	<a href={getTagHref(tag)}>
																		{formatTagHashtag(tag)}
																	</a>
																</>
															))}
														</p>
													)}
												</div>
											)}
											{hasAuthors && (
												<p class="article-listing__authors">
													{articleAuthors.map((author, index) => (
														<>
															{index > 0 && ", "}
															<a href={getAuthorHref(author)}>
																{author.data.title}
															</a>
														</>
													))}
												</p>
											)}
											{(showDate || showReadingTime) && (
												<p class="article-listing__meta-row">
													{showDate && (
														<time datetime={article.data.pubDate.toISOString()}>
															{formatArticleDate(article.data.pubDate)}
														</time>
													)}
													{showDate && showReadingTime && " · "}
													{showReadingTime && <span>{readingLabel}</span>}
												</p>
											)}
										</div>
									)}
								</div>
							</div>
						</li>
					);
				})}
			</ul>
		</section>
	)
}

<style>
	.article-listing {
		margin: 2rem 0;
	}

	.article-listing--compact {
		margin: 0;
	}

	.article-listing__list {
		margin: 0;
		padding: 0;
	}

	.article-listing--grid .article-listing__list {
		display: grid;
		grid-template-columns: repeat(var(--article-listing-cols, 3), minmax(0, 1fr));
		gap: var(--article-listing-gap, 1.25rem);
	}

	.article-listing--list .article-listing__list {
		display: flex;
		flex-direction: column;
		gap: var(--article-listing-gap, 1.5rem);
	}

	.article-listing--grid .article-listing__item {
		/* Same tokens as .grid-card; override via Site-Code / page head. */
		--card-pad-block: 1.1rem;
		--card-pad-inline: 1.15rem;
		display: flex;
		flex-direction: column;
		padding: var(--card-pad-block) var(--card-pad-inline);
		background: var(--color-surface-glass);
		border: 1px solid var(--color-border);
		border-radius: 6px;
		min-width: 0;
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
	}

	@media (prefers-reduced-motion: reduce) {
		.article-listing--grid .article-listing__item {
			-webkit-backdrop-filter: none;
			backdrop-filter: none;
		}
	}

	.article-listing__layout {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		flex: 1 1 auto;
		min-width: 0;
		height: 100%;
	}

	.article-listing__body {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		flex: 1 1 auto;
		min-width: 0;
	}

	.article-listing__link,
	.article-listing__main {
		display: block;
		color: inherit;
		text-decoration: none;
		min-width: 0;
	}

	.article-listing--linkable .article-listing__link:hover .article-listing__title {
		color: var(--color-action);
	}

	.article-listing--nolink .article-listing__title {
		color: var(--color-text);
	}

	.article-listing__copy {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		min-width: 0;
	}

	.article-listing__media {
		display: block;
		overflow: hidden;
		border-radius: var(--radius-image, 0px);
		aspect-ratio: 16 / 9;
		background: var(--color-surface);
		flex-shrink: 0;
	}

	.article-listing--list .article-listing__media {
		max-width: 14rem;
	}

	.article-listing__image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* bottom: image after body (column-reverse) */
	.article-listing--image-bottom-cover .article-listing__layout,
	.article-listing--image-bottom-bleed .article-listing__layout {
		flex-direction: column-reverse;
	}

	/* top/bottom bleed: full width to card edges */
	.article-listing--image-top-bleed.article-listing--grid .article-listing__item {
		padding-top: 0;
	}

	.article-listing--image-top-bleed.article-listing--grid .article-listing__media {
		margin: 0 calc(-1 * var(--card-pad-inline));
		width: calc(100% + 2 * var(--card-pad-inline));
		max-width: none;
		border-radius: 5px 5px 0 0;
	}

	.article-listing--image-bottom-bleed.article-listing--grid .article-listing__item {
		padding-bottom: 0;
	}

	.article-listing--image-bottom-bleed.article-listing--grid .article-listing__media {
		margin: 0 calc(-1 * var(--card-pad-inline));
		width: calc(100% + 2 * var(--card-pad-inline));
		max-width: none;
		border-radius: 0 0 5px 5px;
	}

	/* left / right: image column, body (title + meta) beside it */
	.article-listing--image-left-cover .article-listing__layout,
	.article-listing--image-left-bleed .article-listing__layout,
	.article-listing--image-right-cover .article-listing__layout,
	.article-listing--image-right-bleed .article-listing__layout {
		flex-direction: row;
		align-items: stretch;
		gap: 0.85rem;
	}

	.article-listing--image-right-cover .article-listing__layout,
	.article-listing--image-right-bleed .article-listing__layout {
		flex-direction: row-reverse;
	}

	.article-listing--image-left-cover .article-listing__media,
	.article-listing--image-left-bleed .article-listing__media,
	.article-listing--image-right-cover .article-listing__media,
	.article-listing--image-right-bleed .article-listing__media {
		width: 10rem;
		max-width: 10rem;
		aspect-ratio: 1;
	}

	.article-listing--image-left-cover.article-listing--list .article-listing__media,
	.article-listing--image-left-bleed.article-listing--list .article-listing__media,
	.article-listing--image-right-cover.article-listing--list .article-listing__media,
	.article-listing--image-right-bleed.article-listing--list .article-listing__media {
		width: 10rem;
		max-width: 10rem;
	}

	/*
	 * side bleed: image flush to top, bottom and outer side of the card;
	 * text column keeps its own padding.
	 */
	.article-listing--image-left-bleed.article-listing--grid .article-listing__item,
	.article-listing--image-right-bleed.article-listing--grid .article-listing__item {
		padding: 0;
	}

	.article-listing--image-left-bleed.article-listing--grid .article-listing__layout,
	.article-listing--image-right-bleed.article-listing--grid .article-listing__layout {
		gap: 0;
	}

	.article-listing--image-left-bleed.article-listing--grid .article-listing__media,
	.article-listing--image-right-bleed.article-listing--grid .article-listing__media {
		align-self: stretch;
		height: auto;
		min-height: 10rem;
		aspect-ratio: auto;
		width: 10rem;
		max-width: 10rem;
	}

	.article-listing--image-left-bleed.article-listing--grid .article-listing__media {
		border-radius: 5px 0 0 5px;
	}

	.article-listing--image-right-bleed.article-listing--grid .article-listing__media {
		border-radius: 0 5px 5px 0;
	}

	.article-listing--image-left-bleed.article-listing--grid .article-listing__body {
		padding: var(--card-pad-block) var(--card-pad-inline) var(--card-pad-block) 0.85rem;
	}

	.article-listing--image-right-bleed.article-listing--grid .article-listing__body {
		padding: var(--card-pad-block) 0.85rem var(--card-pad-block) var(--card-pad-inline);
	}

	@media (max-width: 679px) {
		.article-listing--image-left-cover.article-listing--grid .article-listing__layout,
		.article-listing--image-left-bleed.article-listing--grid .article-listing__layout,
		.article-listing--image-right-cover.article-listing--grid .article-listing__layout,
		.article-listing--image-right-bleed.article-listing--grid .article-listing__layout {
			flex-direction: column;
		}

		.article-listing--image-left-cover.article-listing--grid .article-listing__media,
		.article-listing--image-left-bleed.article-listing--grid .article-listing__media,
		.article-listing--image-right-cover.article-listing--grid .article-listing__media,
		.article-listing--image-right-bleed.article-listing--grid .article-listing__media {
			width: 100%;
			max-width: none;
			aspect-ratio: 16 / 9;
			height: auto;
			min-height: 0;
			border-radius: var(--radius-image, 0px);
		}

		.article-listing--image-left-bleed.article-listing--grid .article-listing__item,
		.article-listing--image-right-bleed.article-listing--grid .article-listing__item {
			padding: 0;
		}

		.article-listing--image-left-bleed.article-listing--grid .article-listing__layout,
		.article-listing--image-right-bleed.article-listing--grid .article-listing__layout {
			gap: 0;
		}

		.article-listing--image-left-bleed.article-listing--grid .article-listing__media,
		.article-listing--image-right-bleed.article-listing--grid .article-listing__media {
			border-radius: 5px 5px 0 0;
		}

		.article-listing--image-left-bleed.article-listing--grid .article-listing__body,
		.article-listing--image-right-bleed.article-listing--grid .article-listing__body {
			padding: 0.85rem var(--card-pad-inline) var(--card-pad-block);
		}
	}

	.article-listing__title {
		margin: 0;
		font-size: 1.1rem;
		font-weight: var(--font-weight-heading);
		line-height: 1.3;
		color: var(--color-text);
	}

	.article-listing--list .article-listing__title {
		font-size: 1.125rem;
	}

	.article-listing__summary {
		margin: 0;
	}

	/* Categories + tags on one row; date / reading time below. */
	.article-listing__meta {
		margin: 0;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.35rem;
	}

	.article-listing--grid .article-listing__meta {
		margin-top: auto;
	}

	.article-listing__taxonomies {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: flex-start;
		gap: 0.35rem 1rem;
		width: 100%;
	}

	.article-listing__meta-row,
	.article-listing__categories,
	.article-listing__tags,
	.article-listing__authors {
		margin: 0;
	}

	.article-listing__categories {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem 0.65rem;
	}

	.article-listing__meta a {
		color: var(--color-action);
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 1023px) {
		.article-listing--grid .article-listing__list {
			grid-template-columns: repeat(min(2, var(--article-listing-cols, 3)), minmax(0, 1fr));
		}
	}

	@media (max-width: 679px) {
		.article-listing--grid .article-listing__list {
			grid-template-columns: 1fr;
		}
	}
</style>
