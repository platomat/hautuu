---
/**
 * Site logo from General → Logos (or `/assets/logo-mark.svg`).
 * SVGs are inlined as authored; raster formats use Astro Image.
 * Optional `cmsPath` overrides the configured slot (e.g. maintenance logo).
 */
import { Image } from "astro:assets";
import {
	resolveLogo,
	resolveLogoFromCmsPath,
	type LogoSlot,
} from "../lib/site-logo";

interface Props {
	/** Which configured logo (sticky/footer fall back to header). Ignored when `cmsPath` is set. */
	variant?: LogoSlot;
	/** Explicit CMS media path; when set, used instead of `variant`. */
	cmsPath?: string;
	class?: string;
}

const { variant = "header", cmsPath, class: className } = Astro.props;
const logo = cmsPath?.trim()
	? resolveLogoFromCmsPath(cmsPath)
	: resolveLogo(variant);
---

{
	logo.kind === "svg" ? (
		<span
			class:list={["logo-mark", className]}
			aria-hidden="true"
			set:html={logo.html}
		/>
	) : (
		<span
			class:list={["logo-mark", "logo-mark--raster", className]}
			aria-hidden="true"
		>
			<Image
				src={logo.meta}
				alt=""
				width={logo.meta.width}
				height={logo.meta.height}
			/>
		</span>
	)
}

<style>
	.logo-mark :global(svg) {
		display: block;
		width: 100%;
		height: auto;
	}

	.logo-mark--raster :global(img) {
		display: block;
		width: 100%;
		height: auto;
		object-fit: contain;
	}
</style>
