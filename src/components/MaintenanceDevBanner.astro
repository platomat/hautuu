---
import { MAINTENANCE_PREVIEW_PATH } from "../lib/maintenance";

/**
 * Visible in `astro dev` when Wartungsmodus is on (not on the preview URL).
 */
---

<div class="maintenance-dev-banner" role="status">
	<strong>Wartungsmodus an</strong>
	<span>
		Online sehen Besucher nur die Wartungsseite, nicht den normalen Inhalt.
	</span>
	<a
		class="maintenance-dev-banner__preview"
		href={MAINTENANCE_PREVIEW_PATH}
		target="_blank"
		rel="noopener noreferrer"
	>
		Wartungsseite ansehen
	</a>
</div>

<style>
	.maintenance-dev-banner {
		position: sticky;
		top: 0;
		z-index: 40;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.35rem 0.75rem;
		padding: 0.55rem var(--shell-padding-inline);
		background: var(--color-action-muted);
		color: var(--color-text);
		border-bottom: 1px solid var(--color-border);
		font-size: 0.875rem;
		line-height: 1.4;
	}

	.maintenance-dev-banner strong {
		font-weight: var(--font-weight-heading);
		color: var(--color-action);
	}

	.maintenance-dev-banner__preview {
		margin-inline-start: auto;
		font-weight: var(--font-weight-heading);
		color: var(--color-action);
		text-decoration: underline;
		text-underline-offset: 0.12em;
	}

	.maintenance-dev-banner__preview:hover {
		color: var(--color-action-hover);
	}
</style>
