---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PageBackground from "../components/PageBackground.astro";
import MaintenanceDevBanner from "../components/MaintenanceDevBanner.astro";
import MaintenancePage from "../components/MaintenancePage.astro";
import { formatModifiedDateMeta } from "../cms/fields/dates";
import {
	buildRobotsContent,
	resolveSeo,
	type Seo,
} from "../cms/fields/seo";
import { resolveCmsImage } from "../lib/cms-image";
import { getBuildId } from "../lib/build-id";
import {
	maintenanceMetaDescription,
	renderMaintenanceDescription,
	shouldServeMaintenancePage,
	shouldShowMaintenanceDevBanner,
	getMaintenanceConfig,
	isMaintenancePreviewPath,
} from "../lib/maintenance";
import { buildSiteBorderRadiusRootCss } from "../lib/site-border-radius";
import {
	buildSiteColorRootCss,
	isSurfaceGlassTranslucent,
} from "../lib/site-colors";
import { getSiteCodeConfig, getSiteWebsiteTitle } from "../lib/site-config";
import { getFaviconLinks } from "../lib/site-favicon";
import {
	buildSiteTypographyRootCss,
	getFontPreloadHrefs,
} from "../lib/site-typography";

interface Props {
	title?: string;
	description?: string;
	seo?: Seo;
	/** Open Graph type (default website; articles pass `article`). */
	ogType?: "website" | "article";
	/** Estimated reading time in minutes (articles). */
	readingTimeMinutes?: number;
	/** Last editorial change — emitted as SEO meta only. */
	modifiedDate?: Date;
	backgroundImage?: ImageMetadata;
	backgroundOverlay?: number;
	/** Raw HTML before `</head>` (entry `siteCode.headCode`; after global Site-Code). */
	headCode?: string;
	/** Raw HTML before `</body>` (entry `siteCode.footerCode`; after global Site-Code). */
	footerCode?: string;
	/** Optional Schema.org JSON-LD object or graph. */
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const siteName = await getSiteWebsiteTitle();
const siteCode = getSiteCodeConfig();
const siteColorRootCss = buildSiteColorRootCss();
const siteTypographyRootCss = buildSiteTypographyRootCss();
const siteBorderRadiusRootCss = buildSiteBorderRadiusRootCss();
const fontPreloadHrefs = getFontPreloadHrefs();

const pathname = Astro.url.pathname;
const serveMaintenance = shouldServeMaintenancePage(pathname);
const showMaintenanceDevBanner = shouldShowMaintenanceDevBanner(pathname);
const maintenancePreview = isMaintenancePreviewPath(pathname);
const maintenance = serveMaintenance || showMaintenanceDevBanner
	? getMaintenanceConfig()
	: null;

let {
	title = siteName,
	description,
	seo: seoProp,
	ogType = "website",
	readingTimeMinutes,
	modifiedDate,
	backgroundImage,
	backgroundOverlay,
	headCode,
	footerCode,
	jsonLd,
} = Astro.props;

let maintenanceDescriptionHtml = "";
if (serveMaintenance && maintenance) {
	title = maintenance.title;
	description = maintenanceMetaDescription(maintenance.description);
	seoProp = {
		seo_title: maintenance.title,
		seo_description: description,
		// Preview URL must not be indexed; live maintenance page may be.
		index_visibility: maintenancePreview ? "noindex" : "index",
	};
	ogType = "website";
	readingTimeMinutes = undefined;
	modifiedDate = undefined;
	backgroundImage = resolveCmsImage(maintenance.background?.image);
	backgroundOverlay = maintenance.background?.overlay;
	headCode = undefined;
	footerCode = undefined;
	jsonLd = undefined;
	maintenanceDescriptionHtml = await renderMaintenanceDescription(
		maintenance.description,
	);
}

const globalHeadCodeHtml = !serveMaintenance
	? siteCode.headCode.trim() || undefined
	: undefined;
const globalFooterCodeHtml = !serveMaintenance
	? siteCode.footerCode.trim() || undefined
	: undefined;
const headCodeHtml = !serveMaintenance
	? headCode?.trim() || undefined
	: undefined;
const footerCodeHtml = !serveMaintenance
	? footerCode?.trim() || undefined
	: undefined;
const jsonLdScript =
	jsonLd !== undefined
		? JSON.stringify(jsonLd).replace(/</g, "\\u003c")
		: undefined;
const seo = resolveSeo(seoProp);

const documentTitle = seo.seo_title?.trim() || title;
const pageTitle =
	documentTitle === siteName ? documentTitle : `${documentTitle} · ${siteName}`;
const metaDescription =
	seo.seo_description?.trim() || description?.trim() || undefined;
const robots = buildRobotsContent(seo);
const buildId = getBuildId();
const hasPageBackground = Boolean(backgroundImage);
const hasChromeGlass = isSurfaceGlassTranslucent();
const modifiedMeta = modifiedDate
	? formatModifiedDateMeta(modifiedDate)
	: undefined;
const canonicalURL = Astro.site
	? new URL(serveMaintenance ? "/" : Astro.url.pathname, Astro.site)
	: undefined;
const sitemapURL = Astro.site
	? new URL("sitemap-index.xml", Astro.site)
	: "/sitemap-index.xml";

/** Absolute OG share image from page/article background (1200×630). */
let ogImageURL: string | undefined;
if (backgroundImage && Astro.site) {
	const ogImage = await getImage({
		src: backgroundImage,
		width: 1200,
		height: 630,
		fit: "cover",
		format: "jpg",
	});
	ogImageURL = new URL(ogImage.src, Astro.site).href;
}
const twitterCard = ogImageURL ? "summary_large_image" : "summary";
const readingMinutes =
	typeof readingTimeMinutes === "number" &&
	Number.isFinite(readingTimeMinutes) &&
	readingTimeMinutes > 0
		? Math.round(readingTimeMinutes)
		: undefined;
const faviconLinks = getFaviconLinks();
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		{
			faviconLinks.map((icon) => (
				<link
					rel="icon"
					href={icon.href}
					type={icon.type}
					media={icon.media}
				/>
			))
		}
		<link rel="sitemap" type="application/xml" href={sitemapURL.toString()} title="Sitemap" />
		{canonicalURL && <link rel="canonical" href={canonicalURL.href} />}
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="build-id" content={buildId} />
		<meta name="robots" content={robots} />
		{metaDescription && <meta name="description" content={metaDescription} />}
		<meta property="og:title" content={pageTitle} />
		{metaDescription && <meta property="og:description" content={metaDescription} />}
		<meta property="og:type" content={ogType} />
		<meta property="og:locale" content="de_DE" />
		<meta property="og:site_name" content={siteName} />
		{canonicalURL && <meta property="og:url" content={canonicalURL.href} />}
		{
			ogImageURL && (
				<>
					<meta property="og:image" content={ogImageURL} />
					<meta property="og:image:width" content="1200" />
					<meta property="og:image:height" content="630" />
					<meta name="twitter:image" content={ogImageURL} />
				</>
			)
		}
		<meta name="twitter:card" content={twitterCard} />
		<meta name="twitter:title" content={pageTitle} />
		{metaDescription && <meta name="twitter:description" content={metaDescription} />}
		{
			readingMinutes !== undefined && (
				<>
					<meta name="reading-time" content={`${readingMinutes}`} />
					<meta name="twitter:label1" content="Lesezeit" />
					<meta
						name="twitter:data1"
						content={
							readingMinutes === 1 ? "1 Minute" : `${readingMinutes} Minuten`
						}
					/>
				</>
			)
		}
		{
			modifiedMeta && (
				<>
					<meta property="article:modified_time" content={modifiedMeta} />
					<meta property="og:updated_time" content={modifiedMeta} />
				</>
			)
		}
		<title>{pageTitle}</title>
		{
			fontPreloadHrefs.map((href) => (
				<link
					rel="preload"
					href={href}
					as="font"
					type="font/woff2"
					crossorigin
				/>
			))
		}
		{globalHeadCodeHtml && <Fragment set:html={globalHeadCodeHtml} />}
		{headCodeHtml && <Fragment set:html={headCodeHtml} />}
		{
			!serveMaintenance && jsonLdScript && (
				<script
					type="application/ld+json"
					set:html={jsonLdScript}
				/>
			)
		}
		{/* After bundled CSS: Design → Farbpalette / Schrift / Ecken must win over global.css. */}
		<style is:inline set:html={siteColorRootCss} />
		<style is:inline set:html={siteTypographyRootCss} />
		<style is:inline set:html={siteBorderRadiusRootCss} />
	</head>
	<body
		class:list={{
			"has-page-bg": hasPageBackground,
			"has-chrome-glass": hasChromeGlass,
			"is-maintenance": serveMaintenance,
		}}
	>
		{showMaintenanceDevBanner && <MaintenanceDevBanner />}
		{
			hasPageBackground && (
				<PageBackground image={backgroundImage} overlay={backgroundOverlay} />
			)
		}
		{
			serveMaintenance ? (
				<>
					<div class="site-main site-main--maintenance">
						<MaintenancePage
							title={maintenance?.title ?? "Wartungsarbeiten"}
							descriptionHtml={maintenanceDescriptionHtml}
							showLogo={maintenance?.logo?.show === true}
							logoCmsPath={maintenance?.logo?.image}
							logoSize={maintenance?.logo?.size}
						/>
					</div>
					<SiteFooter copyrightOnly />
				</>
			) : (
				<>
					<SiteHeader />
					<div class="site-main">
						<slot />
					</div>
					<SiteFooter />
					{globalFooterCodeHtml && (
						<Fragment set:html={globalFooterCodeHtml} />
					)}
					{footerCodeHtml && <Fragment set:html={footerCodeHtml} />}
				</>
			)
		}
	</body>
</html>

<style is:global>
	body.is-maintenance {
		min-height: 100vh;
	}

	body.is-maintenance .site-main--maintenance {
		display: flex;
		flex-direction: column;
		flex: 1 0 auto;
	}
</style>
